from fastapi import FastAPI, Depends, HTTPException, status
from sqlalchemy.orm import Session
from sqlalchemy import or_

from .config import APP_NAME
from .database import Base, engine, get_db
from .models import User, Conversation, ConversationMember
from .schemas import RegisterRequest, LoginRequest, TokenResponse, UserResponse, ConversationCreate, ConversationResponse
from .security import hash_password, verify_password, create_access_token
from .auth import get_current_user

Base.metadata.create_all(bind=engine)

app = FastAPI(
    title=APP_NAME,
    version="0.1.0",
    description="KONGCHAT Identity Engine — authentication and identity foundation"
)


@app.get("/health")
def health():
    return {"status": "ok", "service": "kongchat-identity-engine"}


@app.post(
    "/v1/auth/register",
    response_model=UserResponse,
    status_code=status.HTTP_201_CREATED
)
def register(payload: RegisterRequest, db: Session = Depends(get_db)):
    email = payload.email.lower().strip()
    username = payload.username.strip()

    existing = db.query(User).filter(
        or_(User.email == email, User.username == username)
    ).first()

    if existing:
        raise HTTPException(
            status_code=409,
            detail="Email or username already registered"
        )

    user = User(
        email=email,
        username=username,
        password_hash=hash_password(payload.password)
    )

    db.add(user)
    db.commit()
    db.refresh(user)
    return user


@app.post("/v1/auth/login", response_model=TokenResponse)
def login(payload: LoginRequest, db: Session = Depends(get_db)):
    email = payload.email.lower().strip()
    user = db.query(User).filter(User.email == email).first()

    if not user or not verify_password(payload.password, user.password_hash):
        raise HTTPException(
            status_code=401,
            detail="Invalid email or password"
        )

    token, expires_in = create_access_token(user.id)

    return {
        "access_token": token,
        "token_type": "bearer",
        "expires_in": expires_in,
        "user": user
    }


@app.get("/v1/users/me", response_model=UserResponse)
def get_me(current_user: User = Depends(get_current_user)):
    return current_user


@app.post(
    "/v1/conversations",
    response_model=ConversationResponse,
    status_code=status.HTTP_201_CREATED
)
def create_conversation(
    payload: ConversationCreate,
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    # Creator is always included as a member.
    member_ids = list(set(payload.member_ids + [current_user.id]))

    # Validate that every requested user exists.
    users = db.query(User).filter(User.id.in_(member_ids)).all()

    if len(users) != len(member_ids):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="One or more member IDs do not exist"
        )

    conversation = Conversation(
        title=payload.title.strip() if payload.title and payload.title.strip() else None
    )

    db.add(conversation)
    db.flush()

    memberships = [
        ConversationMember(
            conversation_id=conversation.id,
            user_id=user_id
        )
        for user_id in member_ids
    ]

    db.add_all(memberships)
    db.commit()
    db.refresh(conversation)

    return {
        "id": conversation.id,
        "title": conversation.title,
        "created_at": conversation.created_at,
        "member_ids": member_ids
    }


@app.get(
    "/v1/conversations",
    response_model=list[ConversationResponse]
)
def list_conversations(
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    conversations = (
        db.query(Conversation)
        .join(ConversationMember)
        .filter(ConversationMember.user_id == current_user.id)
        .order_by(Conversation.id.desc())
        .all()
    )

    result = []

    for conversation in conversations:
        member_ids = [
            member.user_id for member in conversation.members
        ]

        result.append({
            "id": conversation.id,
            "title": conversation.title,
            "created_at": conversation.created_at,
            "member_ids": member_ids
        })

    return result


@app.get(
    "/v1/conversations",
    response_model=list[ConversationResponse]
)
def list_conversations(
    current_user: User = Depends(get_current_user),
    db: Session = Depends(get_db)
):
    conversations = (
        db.query(Conversation)
        .join(ConversationMember)
        .filter(ConversationMember.user_id == current_user.id)
        .order_by(Conversation.id.desc())
        .all()
    )

    result = []

    for conversation in conversations:
        member_ids = [
            member.user_id for member in conversation.members
        ]

        result.append({
            "id": conversation.id,
            "title": conversation.title,
            "created_at": conversation.created_at,
            "member_ids": member_ids
        })

    return result
